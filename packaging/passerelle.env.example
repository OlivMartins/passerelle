# Variables d’environnement du service Passerelle
# Lu par systemd (EnvironmentFile). Droits posés par install.sh : 0600, root:root.

# Jeton exigé sur l’API /v1 (en-tête Authorization: Bearer …). Généré à l’installation.
PASSERELLE_TOKEN=

# Jetons à portée (facultatif) : un par client, déclarés dans passerelle.yaml (section server.tokens), qui cite ces variables.
# Une portée limite ce que le jeton ouvre : translate (traductions, inventaire, schéma), validate (validation SQL et Vector), metrics.
# Un jeton déclaré dont la variable est vide empêche le démarrage : l’API ne reste jamais ouverte par erreur.
#PASSERELLE_TOKEN_CI=
#PASSERELLE_TOKEN_PROMETHEUS=

# Collecteur de traces OpenTelemetry (facultatif) : valeur citée par server.tracing.headers.
#OTEL_AUTHORIZATION=

# Adresse d’écoute. Gardez 127.0.0.1 et publiez derrière un reverse proxy TLS.
# Hors de la boucle locale (0.0.0.0, ::, une adresse du réseau), PASSERELLE_TOKEN ou server.tokens est obligatoire :
# sans jeton, le service refuse de démarrer, et un rechargement qui retirerait les jetons est refusé.
#PASSERELLE_LISTEN=127.0.0.1:8080

# Gros exports (Kibana, watches, Grafana, Logstash, schéma) : calculés par un worker, hors du fil qui répond à /healthz.
# Un export demande environ 30 fois sa taille en mémoire : au-delà de la limite du worker, il est refusé (413).
# MemoryMax de l’unité systemd (2G par défaut) doit rester au-dessus de la limite du worker, plus 200 Mio.
#PASSERELLE_WORKERS=1
#PASSERELLE_WORKER_MEMORY_MB=1024
#PASSERELLE_WORKER_TIMEOUT_S=100

# Compte ClickHouse utilisé par /v1/validate/sql : SELECT sur les seules tables de index_mapping (docs/INSTALL.md).
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Compte d'écriture que Vector utilise pour la sortie ClickHouse (INSERT) : lu par Vector, pas par Passerelle.
#CLICKHOUSE_SINK_USER=
#CLICKHOUSE_SINK_PASSWORD=

# Binaire Vector utilisé par /v1/validate/vector (facultatif).
#PASSERELLE_VECTOR_BIN=/usr/bin/vector

# Comptes en lecture seule de « passerelle verify » (équivalence sur vos données), lancé hors du service.
#ES_USER=
#ES_PASSWORD=
#ES_API_KEY=
