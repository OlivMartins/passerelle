# Passerelle — service systemd
# Emplacement : /etc/systemd/system/passerelle.service
# Surcharges locales : systemctl edit passerelle (ne modifiez pas ce fichier directement)

[Unit]
Description=Passerelle - traduction Elasticsearch/Logstash vers ClickHouse/Vector
Documentation=file:///usr/local/share/doc/passerelle/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=passerelle
Group=passerelle
EnvironmentFile=-/etc/passerelle/passerelle.env
Environment=PASSERELLE_CONFIG=/etc/passerelle/passerelle.yaml
Environment=PASSERELLE_LISTEN=127.0.0.1:8080
ExecStartPre=/usr/local/bin/passerelle check-config --quiet
ExecStart=/usr/local/bin/passerelle serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s

# Ressources
MemoryMax=1G
TasksMax=128
LimitNOFILE=16384

# Durcissement : aucun privilège, système en lecture seule, /tmp privé
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateUsers=yes
ProtectProc=invisible
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute reste désactivé : le compilateur JIT de V8 a besoin de pages exécutables.

[Install]
WantedBy=multi-user.target
