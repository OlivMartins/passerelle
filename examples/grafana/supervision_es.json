{
  "__inputs": [
    {
      "name": "DS_ELASTICSEARCH",
      "label": "Elasticsearch",
      "description": "",
      "type": "datasource",
      "pluginId": "elasticsearch",
      "pluginName": "Elasticsearch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.3.0"
    },
    {
      "type": "datasource",
      "id": "elasticsearch",
      "name": "Elasticsearch",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Déploiements",
        "query": "event.category:deployment AND service.name:$service",
        "timeField": "@timestamp",
        "textField": "message",
        "tagsField": "service.name"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "id": 42,
  "uid": "web-es",
  "title": "Supervision web (Elasticsearch)",
  "tags": [
    "web"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 7,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"service.name\", \"query\": \"service.environment:production\"}",
        "definition": "{\"find\": \"terms\", \"field\": \"service.name\"}",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "options": []
      },
      {
        "name": "methode",
        "label": "Méthode",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"http.request.method\", \"orderBy\": \"doc_count\", \"size\": 10}",
        "includeAll": false,
        "multi": false,
        "current": {},
        "refresh": 1,
        "options": []
      },
      {
        "name": "champ",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "query": "{\"find\": \"fields\", \"type\": \"keyword\"}",
        "current": {},
        "options": []
      },
      {
        "name": "filtres",
        "type": "adhoc",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "filters": []
      },
      {
        "name": "pas",
        "type": "interval",
        "query": "1m,10m,1h",
        "current": {
          "text": "10m",
          "value": "10m"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requêtes par service",
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "service.name:$service AND service.environment:production",
          "alias": "{{term service.name}}",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "service.name",
              "settings": {
                "size": "5",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latence : moyenne et centiles",
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "service.name:$service",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "event.duration"
            },
            {
              "id": "4",
              "type": "percentiles",
              "field": "event.duration",
              "settings": {
                "percents": [
                  "95",
                  "99"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "10m",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Octets moyens par requête (bucket script)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "service.name:$service",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "count",
              "hide": true
            },
            {
              "id": "5",
              "type": "sum",
              "field": "http.response.bytes",
              "hide": true,
              "settings": {
                "script": "_value / 1024"
              }
            },
            {
              "id": "6",
              "type": "bucket_script",
              "pipelineVariables": [
                {
                  "name": "ko",
                  "pipelineAgg": "5"
                },
                {
                  "name": "n",
                  "pipelineAgg": "1"
                }
              ],
              "settings": {
                "script": "params.ko / params.n"
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
