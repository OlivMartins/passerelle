            {
              "id": "1",
              "type": "sum",
              "field": "http.response.bytes"
            },
            {
              "id": "2",
              "type": "cumulative_sum",
              "field": "1",
              "pipelineAgg": "1"
            },
            {
              "id": "3",
              "type": "derivative",
              "field": "1",
              "pipelineAgg": "1"
            },
            {
              "id": "4",
              "type": "moving_fn",
              "field": "1",
              "pipelineAgg": "1",
              "settings": {
                "window": "5",
                "script": "MovingFunctions.unweightedAvg(values)"
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "9",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1h",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
